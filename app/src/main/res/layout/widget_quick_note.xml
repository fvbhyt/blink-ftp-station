<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件卡片（RemoteViews 布局：只支持有限的原生控件/属性）。
     FrameLayout：左侧文字流 + 右上角小猫装饰（@drawable/cat_deco，透明 PNG） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F6FEB"
    android:padding="12dp">

    <!-- 右上角探头小猫（装饰，透明底；34dp 宽 x 78dp 高 保持 300:694 原图比例） -->
    <ImageView
        android:layout_width="34dp"
        android:layout_height="78dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-4dp"
        android:scaleType="fitCenter"
        android:contentDescription="小猫"
        android:src="@drawable/cat_deco" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="38dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Blink 快速记录"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_note_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_note_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="—"
            android:textColor="#CDE3FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_note_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="—"
            android:textColor="#9DB9E8"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
